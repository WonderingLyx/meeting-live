  "llm": {
    "provider": "ollama",
    "endpoint": "http://127.0.0.1:11434/v1",
    "api_key": "",
    "model": "qwen2.5:1.5b",
    "enabled": false,
    "allow_public": false,
    "timeout_sec": 200,
    "max_input_tokens": 8000,
    "mock": false
  }
