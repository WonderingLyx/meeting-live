{
  "version": 1,
  "asr": {
    "provider": "modelscope",
    "endpoint": "https://modelscope.cn",
    "api_key": "",
    "model": "sensevoice_zh",
    "device": "auto",
    "word_timestamps": false,
    "load_timeout_sec": 90
  },
  "speaker": {
    "provider": "modelscope",
    "endpoint": "https://modelscope.cn",
    "api_key": "",
    "model": "campplus",
    "device": "auto"
  },
  "diarization": {
    "engine": "funasr_campplus",
    "provider": "modelscope",
    "endpoint": "https://modelscope.cn",
    "api_key": "",
    "model": "paraformer-zh + fsmn-vad + ct-punc + cam++",
    "command": "",
    "device": "auto"
  },
  "diarization_funasr_sensevoice_example": {
    "engine": "funasr_sensevoice_campplus",
    "provider": "modelscope",
    "endpoint": "https://modelscope.cn",
    "api_key": "",
    "model": "iic/SenseVoiceSmall + fsmn-vad + cam++",
    "command": "",
    "device": "auto"
  },
  "diarization_pyannote_example": {
    "engine": "pyannote_community",
    "provider": "huggingface",
    "endpoint": "https://huggingface.co",
    "api_key": "",
    "model": "pyannote/speaker-diarization-community-1",
    "command": "",
    "device": "auto"
  },
  "face": {
    "provider": "insightface",
